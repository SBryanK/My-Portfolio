---
import { certs, u } from '../data/site';
---
<section class="sec sec--tint" id="certifications">
  <div class="container">
    <header class="head"><h2 data-reveal>Certifications</h2><p data-reveal>Hover or tap a card to flip it.</p></header>
    <div class="certs">
      {certs.map(c => c.mystery ? (
        <article class="cert cert--mystery" tabindex="0" data-reveal>
          <div class="cert__in">
            <div class="cert__f"><div class="qmark" aria-hidden="true">?</div><h3>{c.issuer}</h3></div>
            <div class="cert__b"><h3>Something new</h3><p>Another badge is on its way.</p></div>
          </div>
        </article>
      ) : (
        <article class="cert" tabindex="0" data-reveal>
          <div class="cert__in">
            <div class="cert__f">{c.img && <img class="cert__img" src={u(`/img/${c.img}`)} alt="" width="86" height="86" loading="lazy" />}<h3>{c.name}</h3><p>{c.issuer}</p>{c.level && <span class="lvl">{c.level}</span>}</div>
            <div class="cert__b"><h3>{c.name}{c.level ? ` · ${c.level}` : ''}</h3><p>{c.issuer}</p><a href={c.href} target="_blank" rel="noopener" data-track="cert_verify">Verify</a></div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
