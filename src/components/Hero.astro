---
import { icon } from './icons';
import { site, marquee, u } from '../data/site';
const loop = [...marquee, ...marquee];
const soc = [['LinkedIn', site.links.linkedin, icon.linkedin], ['GitHub', site.links.github, icon.github], ['Credly', site.links.credly, icon.credly]];
---
<section class="hero" id="home">
  <div class="hero__wash" aria-hidden="true"></div>
  <canvas class="hero__canvas" id="net" aria-hidden="true"></canvas>
  <div class="container hero__grid">
    <div>
      <p class="eyebrow" data-intro>Singapore · open to 2026/27 internships</p>
      <h1 class="hero__title" aria-label="Santasila Bryan Kusno">
        <span class="row" data-split>Santasila</span>
        <span class="row" data-split data-foil>Bryan Kusno</span>
      </h1>
      <div class="hero__roles" data-intro>
        <p><b>NUS MSc</b> Smart Industries and Digital Transformation</p>
        <span>ex-Cloud Solutions Architect at Tencent Cloud · <span class="typed" id="typed">Cloud Architect</span></span>
      </div>
      <p class="hero__desc" data-intro>
        I design cloud and edge infrastructure (CDN, WAF, Anti-DDoS) for some of Indonesia's largest banks and enterprises, and build machine learning systems that turn messy data into decisions people act on.
      </p>
      <div class="hero__btns" data-intro>
        <a class="btn btn--gold" data-magnet data-track="resume_download" href={u('/resume.pdf')} target="_blank" rel="noopener">Download resume <svg viewBox="0 0 24 24" aria-hidden="true"><path d={icon.down}/></svg></a>
        <a class="btn btn--ghost" data-magnet href="#projects">View my work</a>
      </div>
      <ul class="social" data-intro>
        {soc.map(([l, h, p]) => <li><a href={h} target="_blank" rel="noopener" aria-label={l} data-track={`social_${l.toLowerCase()}`}><svg viewBox="0 0 24 24" aria-hidden="true"><path d={p}/></svg></a></li>)}
        <li><a href={`mailto:${site.email}`} aria-label="Email" data-track="contact_click"><svg viewBox="0 0 24 24" aria-hidden="true"><path d={icon.mail}/></svg></a></li>
      </ul>
    </div>
    <div class="medal" id="medal" data-intro>
      <svg class="medal__ring" viewBox="0 0 300 300" aria-hidden="true">
        <defs>
          <linearGradient id="au" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#F3DE9E"/><stop offset=".34" stop-color="#C9962C"/><stop offset=".6" stop-color="#8F6A16"/><stop offset=".82" stop-color="#EBCD78"/><stop offset="1" stop-color="#A87F1F"/></linearGradient>
          <linearGradient id="rd" x1="0" y1="1" x2="1" y2="0"><stop offset="0" stop-color="#D9455C"/><stop offset="1" stop-color="#8E1B2E"/></linearGradient>
        </defs>
        <circle class="medal__dash" cx="150" cy="150" r="145" fill="none" stroke="url(#au)" stroke-width="2" stroke-linecap="round" stroke-dasharray="2 11"/>
        <circle class="medal__sweep" cx="150" cy="150" r="136" fill="none" stroke="url(#rd)" stroke-width="2.5" stroke-linecap="round" stroke-dasharray="120 735"/>
        <circle cx="150" cy="150" r="128" fill="none" stroke="url(#au)" stroke-width="1" opacity=".5"/>
      </svg>
      <div class="medal__photo" id="medalPhoto"><img src={u('/img/bryan.webp')} alt="Portrait of Santasila Bryan Kusno" width="400" height="400" fetchpriority="high" /></div>
      <span class="float float--a"><i></i>Tencent Cloud</span>
      <span class="float float--b"><i></i>NUS MSc</span>
      <span class="float float--c"><i></i>AWS certified</span>
      <span class="chip">Cloud Architect · Data Analyst · Fintech</span>
    </div>
  </div>
  <span class="scroll-cue" aria-hidden="true"></span>
</section>
<div class="rail" aria-hidden="true"><div class="rail__track">
  {loop.map(t => <><span>{t}</span><i>◆</i></>)}
</div></div>
