---
import { u } from '../data/site';
import { community } from '../data/site';
---
<section class="sec sec--tint" id="community">
  <div class="container">
    <header class="head"><h2 data-reveal>Community</h2></header>
    <div class="comm">
      {community.map(c => (
        <article class={`card ccard ${c.star ? 'ccard--star' : ''}`} data-reveal>
          <div class={`logo ${c.img ? '' : 'logo--mark'} ${c.wide ? 'logo--wide' : ''} ${c.fill ? 'logo--fill' : ''}`}>{c.img ? <img src={u(`/img/${c.img}`)} alt="" width="56" height="56" loading="lazy" /> : c.mark}</div>
          <h3>{c.role}</h3><p class="org">{c.org}</p>
          <p class="t" data-fx>{c.text}</p>
          {c.long && <>
            <div class="xp"><div class="xp__in"><p class="t">{c.long}</p></div></div>
            <button class="more-btn" type="button" aria-expanded="false" data-xtoggle data-more="Read more" data-less="Show less">Read more</button>
          </>}
        </article>
      ))}
    </div>
  </div>
</section>
